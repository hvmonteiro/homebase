# Change this before the first launch. It is never committed to Git.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Internal application port. Caddy forwards public traffic to this port.
PORT=3000

# Homebase's host port. The default 8080 avoids conflicts with other services.
HOMEBASE_PORT=8080

# Optional: use a hostname for Caddy-managed HTTPS instead of LAN-only HTTP.
# HOMEBASE_ADDRESS=homebase.example.com
