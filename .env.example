# Change this before the first launch. It is never committed to Git.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional: require this password to view the dashboard. Leave empty for a
# public dashboard. The admin password always retains management access.
GUEST_PASSWORD=

# Internal application port. Caddy forwards public traffic to this port.
PORT=3000

# Homebase's host port. The default 8080 avoids conflicts with other services.
HOMEBASE_PORT=8080

# Optional: use a hostname for Caddy-managed HTTPS instead of LAN-only HTTP.
# HOMEBASE_ADDRESS=homebase.example.com

# Dashboard presentation. These values can be changed without editing Homebase.
APP_TITLE=Homebase · Server dashboard
APP_DESCRIPTION=A shared home-server application dashboard.
APP_FAVICON=/homebase-logo.png
BRAND_TITLE=Homebase
BRAND_TAGLINE=Your private launchpad
DASHBOARD_INTRO=Everything running at home, in one calm place.
DASHBOARD_INTRO_TAGLINE=A shared launchpad for the services you host. Everyone sees the same application directory.

# Seconds between application availability checks (10 to 3600).
DASHBOARD_REFRESH_TIME=60
