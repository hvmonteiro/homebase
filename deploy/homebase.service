[Unit]
Description=Homebase shared home-server dashboard
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/home/homebase/compose.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
User=homebase
Group=homebase
SupplementaryGroups=docker
WorkingDirectory=/home/homebase
Environment=HOME=/home/homebase
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
