[Unit]
Description=Homebase shared home-server dashboard
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/compose.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d
TimeoutStartSec=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
